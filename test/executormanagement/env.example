# 执行机管理集成测试环境配置示例
# 复制此文件为 .env 并修改相应的值
# 或者直接在命令行中设置这些环境变量

# ==================== API 配置 ====================
# API 基础 URL
EXEC_API_BASE_URL=http://localhost:8080

# WebSocket URL
EXEC_WS_URL=ws://localhost:8080/ws/executor

# WebSocket 测试开关 (0=关闭, 1=启用)
EXEC_WS_ENABLE=0

# ==================== Agent 认证配置 ====================
# 执行机名称
EXEC_AGENT_NAME=Executor_PC_001

# Agent 用户名
EXEC_AGENT_USERNAME=agent_user

# SHA256 Hash (必需，用于 CHAP 认证)
# 使用以下 Python 代码生成:
#   import hashlib
#   password = "your_password"
#   sha256_hash = hashlib.sha256(password.encode('utf-8')).hexdigest().upper()
#   print(sha256_hash)
# 示例（test123的SHA256 Hash）：ECD71870D1963316A97E3AC3408C9835AD8CF0F3C1BC703527C30265534F75AE
EXEC_AGENT_SHA256_HASH=

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dialingtest_test
DB_USER=postgres
DB_PASSWORD=postgres

# ==================== 超时配置 ====================
# WebSocket 连接超时（秒）
EXEC_WS_TIMEOUT=10

# 等待执行机离线超时（秒）
EXEC_WS_WAIT_OFFLINE_SEC=5

# ==================== 性能测试配置 ====================
# 并发测试开关 (0=关闭, 1=启用)
EXEC_CONCURRENCY_ENABLE=0

# ==================== 日志配置 ====================
# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 日志目录
LOG_DIR=./logs

